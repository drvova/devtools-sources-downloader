{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "The project's design tokens, codified from docs/design/sculptural-industrial-futurism.md (primary) and docs/design/dither-ui.md. The banner in assets/banner/ is the first consumer; any future surface reads this file rather than restating a hex.",
  "color": {
    "$description": "design.md \u00a75: 75% neutrals, 20% material midtones, 5% accent. One accent family per composition.",
    "carbon": {
      "$value": "#0B0E11",
      "$type": "color",
      "$description": "main dark canvas"
    },
    "graphite": {
      "$value": "#181D21",
      "$type": "color",
      "$description": "raised surfaces, dark shells"
    },
    "gunmetal": {
      "$value": "#384249",
      "$type": "color",
      "$description": "secondary structure"
    },
    "alloy": {
      "$value": "#79848B",
      "$type": "color",
      "$description": "quiet outlines, neutral metal"
    },
    "titanium": {
      "$value": "#B6C0C5",
      "$type": "color",
      "$description": "metallic light edges"
    },
    "mist": {
      "$value": "#E7ECEE",
      "$type": "color",
      "$description": "light UI text"
    },
    "ceramic": {
      "$value": "#F5F7F6",
      "$type": "color",
      "$description": "editorial background"
    },
    "optic": {
      "$value": "#62CFDE",
      "$type": "color",
      "$description": "the one accent: cool optical signal"
    },
    "signal": {
      "$value": "#FF7A45",
      "$type": "color",
      "$description": "a single action or warning; unused here"
    },
    "lime": {
      "$value": "#C4E65C",
      "$type": "color",
      "$description": "sport accent; unused here"
    },
    "iridium": {
      "$value": "#8C83CC",
      "$type": "color",
      "$description": "iridescent detail; unused here"
    },
    "obsidian": {
      "$value": "#101214",
      "$type": "color",
      "$description": "dither-ui ground: the print"
    },
    "bone": {
      "$value": "#E4E1D8",
      "$type": "color",
      "$description": "dither-ui ink: all body text"
    },
    "muted": {
      "$value": "#9C998F",
      "$type": "color",
      "$description": "dither-ui second ink"
    },
    "ember": {
      "$value": "#FF9632",
      "$type": "color",
      "$description": "dither-ui signal: the one live thing"
    },
    "graphite2": {
      "$value": "#25292D",
      "$type": "color",
      "$description": "dither-ui supporting neutral, materials only"
    }
  },
  "font": {
    "$description": "design.md \u00a76: one display face, one metadata face, both SIL OFL and self-hosted.",
    "display": {
      "$value": "Space Grotesk",
      "$type": "fontFamily",
      "file": "SpaceGrotesk-Variable.ttf",
      "weight": 600
    },
    "mono": {
      "$value": "IBM Plex Mono",
      "$type": "fontFamily",
      "file": "IBMPlexMono-Regular.ttf",
      "weight": 400
    },
    "extended": {
      "$value": "Michroma",
      "$type": "fontFamily",
      "file": "Michroma-Regular.ttf",
      "weight": 400
    }
  },
  "tracking": {
    "$description": "design.md \u00a76: moderate positive tracking for display caps; default elsewhere.",
    "display": {
      "$value": 2,
      "$type": "dimension",
      "$description": "px, on the wordmark"
    },
    "mono": {
      "$value": 1.2,
      "$type": "dimension",
      "$description": "px, on the spec line"
    }
  },
  "motion": {
    "$description": "design.md \u00a78: decisive travel, soft settling, minimal overshoot.",
    "ease": {
      "$value": [
        0.2,
        0.7,
        0.2,
        1
      ],
      "$type": "cubicBezier"
    },
    "micro": {
      "$value": 150,
      "$type": "duration",
      "$description": "ms, micro feedback"
    },
    "panel": {
      "$value": 250,
      "$type": "duration",
      "$description": "ms, panel reveal"
    },
    "hero": {
      "$value": 400,
      "$type": "duration",
      "$description": "ms, hero object transition"
    }
  },
  "ratio": {
    "$description": "design.md \u00a75: the colour ratio a composition keeps.",
    "neutrals": 0.75,
    "midtones": 0.2,
    "accent": 0.05
  }
}