(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (merge-pathnames "tools/cl/vovas-engine.asd" (uiop:getcwd)))
(asdf:load-system :vovas-engine :force :all)
(in-package :vovas.engine.gate)
(let* ((fx (read-json-file (fixture-path "panel/boundary-oracle.json")))
       (input (gethash "input" fx))
       (scripts (coerce (gethash "scriptFixture" input) 'list))
       (rf (gethash "reconFixture" input))
       (recon (let ((c (make-hash-table :test #'equal)))
                (maphash (lambda (k v) (setf (gethash k c) v)) rf)
                (setf (gethash "recon" c) (gethash "recon" input))
                (setf (gethash "frameworkState" c) (gethash "frameworkState" input))
                c))
       (a (vovas.engine.panel.analysis:build-semantic-analysis
           scripts recon
           (coerce (gethash "runtimeEntries" input) 'list)
           (coerce (gethash "runtimeManifest" input) 'list)))
       (inv (vovas.engine.panel.assets:field a "investigation")))
  (format t "~&INV type ~a keys ~s~%" (type-of inv)
          (and (hash-table-p inv) (loop for k being the hash-keys of inv collect k)))
  (let ((ws (vovas.engine.panel.assets:field inv "workspaces")))
    (format t "~&WS type ~a len ~a~%" (type-of ws)
            (if (or (vectorp ws) (listp ws)) (length ws) -1))
    (when (and ws (plusp (length ws)))
      (let ((w0 (aref ws 0)))
        (format t "~&W0 type ~a keys ~s~%" (type-of w0)
                (and (hash-table-p w0) (loop for k being the hash-keys of w0 collect k)))
        (format t "~&W0 id via field-str: ~s~%"
                (vovas.engine.panel.assets:field-str w0 "id"))))))
