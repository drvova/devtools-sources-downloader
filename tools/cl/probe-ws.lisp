;;;; probe-ws.lisp - ad-hoc workspace/analysis probes.
(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (merge-pathnames "tools/cl/vovas-engine.asd" (uiop:getcwd)))
(asdf:load-system :vovas-engine)

(in-package :vovas.engine.gate)

(defun pdiff (got want &optional (path ""))
  (cond
    ((and (hash-table-p got) (hash-table-p want))
     (dolist (k (sort (remove-duplicates
                       (append (loop for x being the hash-keys of got collect x)
                               (loop for x being the hash-keys of want collect x))
                       :test #'string=)
                      #'string<))
       (multiple-value-bind (gv gp) (gethash k got)
         (multiple-value-bind (wv wp) (gethash k want)
           (cond ((and gp wp) (pdiff gv wv (format nil "~a.~a" path k)))
                 ((and (not gp) wp) (format t "~&  ~a.~a: MISSING (want ~s)~%" path k (if (hash-table-p wv) :table wv)))
                 ((and gp (not wp)) (format t "~&  ~a.~a: EXTRA (got ~s)~%" path k (if (hash-table-p gv) :table gv))))))))
    ((and (or (vectorp got) (listp got)) (or (vectorp want) (listp want)))
     (let ((g (coerce got 'list)) (w (coerce want 'list)))
       (unless (= (length g) (length w))
         (format t "~&  ~a: LENGTH got=~a want=~a~%" path (length g) (length w)))
       (loop for i below (min (length g) (length w) 2)
             do (pdiff (nth i g) (nth i w) (format nil "~a[~a]" path i)))))
    ((not (equal got want))
     (format t "~&  ~a: got=~s want=~s~%" path got want))))

(let* ((fx (read-json-file (fixture-path "panel/boundary-oracle.json")))
       (input (gethash "input" fx))
       (want (gethash "buildSemanticAnalysis" (gethash "expected" fx)))
       (scripts (coerce (gethash "scriptFixture" input) 'list))
       (rf (gethash "reconFixture" input))
       (recon (let ((c (make-hash-table :test #'equal)))
                (maphash (lambda (k v) (setf (gethash k c) v)) rf)
                (setf (gethash "recon" c) (gethash "recon" input))
                (setf (gethash "frameworkState" c) (gethash "frameworkState" input))
                c))
       (got (vovas.engine.panel.analysis:build-semantic-analysis
             scripts recon
             (coerce (gethash "runtimeEntries" input) 'list)
             (coerce (gethash "runtimeManifest" input) 'list)))
       (gc (gate-strip-clocks got))
       (wc (gate-strip-clocks want)))
  (dolist (key '("moduleGraph" "startupChain" "runtimeOrigins"))
    (format t "~&===== ~a~%" key)
    (pdiff (gethash key gc) (gethash key wc)))
  (format t "~&===== frameworkRuntime~%")
  (pdiff (gethash "frameworkRuntime" gc) (gethash "frameworkRuntime" wc)))
