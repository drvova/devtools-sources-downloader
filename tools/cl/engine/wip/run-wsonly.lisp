(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (merge-pathnames "tools/cl/vovas-engine.asd" (uiop:getcwd)))
(asdf:load-system :vovas-engine :force :all)
(format t "~&=== loaded ===~%")
(dolist (spec '((:builders . vovas.engine.gate::run-workspace-builders-gate)
                (:investigation . vovas.engine.gate::run-investigation-workspace-gate)))
  (format t "~&=== ~a ===" (car spec))
  (handler-case (format t "~&result: ~a~%" (funcall (cdr spec)))
    (error (e) (format t "~&ERROR: ~a~%" e))))
