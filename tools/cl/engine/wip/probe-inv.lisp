(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (merge-pathnames "tools/cl/vovas-engine.asd" (uiop:getcwd)))
(asdf:load-system :vovas-engine :force :all)
(let* ((page (let ((h (make-hash-table :test #'equal)))
               (setf (gethash "title" h) "T <x>"
                     (gethash "url" h) "https://demo.test/app")
               h))
       (inv (let ((h (make-hash-table :test #'equal)))
              (setf (gethash "page" h) page
                    (gethash "note" h) "</script>&")
              h))
       (doc (vovas.engine.panel.report:generate-investigation-index-html inv)))
  (format t "~&LEN ~a~%" (length doc))
  (format t "~&HEAD ~s~%" (subseq doc 0 60))
  (format t "~&ID0 ~a~%" (and (search "id=\"workspaceNav\"" doc) t))
  (format t "~&ID1 ~a~%" (and (search "id=\"journeyNav\"" doc) t))
  (format t "~&ID2 ~a~%" (and (search "id=\"investigation-data\"" doc) t))
  (format t "~&ESC ~a~%" (and (search "\\u003c/script\\u003e" doc) t))
  (format t "~&TIT ~a~%" (and (search "&lt;x&gt;" doc) t))
  (format t "~&TAIL ~s~%" (subseq doc (- (length doc) 40))))
