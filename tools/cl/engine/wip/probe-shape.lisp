(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (merge-pathnames "tools/cl/vovas-engine.asd" (uiop:getcwd)))
(asdf:load-system :vovas-engine :force :all)
(in-package :vovas.engine.gate)
(let* ((fx (read-json-file (fixture-path "panel/boundary-oracle.json")))
       (an (gate-analysis-fixture))
       (inv (vovas.engine.panel.workspace:build-investigation-workspace an))
       (ws-raw (vovas.engine.panel.assets:field inv "workspaces")))
  (format t "~&RAW type ~a len ~a~%" (type-of ws-raw)
          (if (or (vectorp ws-raw) (listp ws-raw)) (length ws-raw) -1))
  (let ((w0 (aref ws-raw 0)))
    (format t "~&RAW-ELEM type ~a first ~s~%" (type-of w0)
            (if (consp w0) (car w0) w0)))
  (let ((w (vovas.engine.panel.analysis:analysis-wire ws-raw)))
    (format t "~&WIRED type ~a len ~a~%" (type-of w)
            (if (or (vectorp w) (listp w)) (length w) -1))))
