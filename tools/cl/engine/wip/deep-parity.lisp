(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (merge-pathnames "tools/cl/vovas-engine.asd" (uiop:getcwd)))
(asdf:load-system :vovas-engine :force :all)

(in-package :vovas.engine.gate)

(let* ((fx (vovas.engine.gate::read-json-file
            (vovas.engine.gate::fixture-path "panel/finalize-oracle.json")))
       (inp (gethash "inputs" fx))
       (exp (gethash "expected" fx))
       (opt (gethash "options" inp))
       (assets (coerce (gethash "jsAssets" inp) 'list))
       (recon (gethash "reconData" inp))
       (payloads (gethash "runtimePayloads" inp))
       (opts (vovas.engine.pipeline:make-unpack-options
              :path-prefix (or (and opt (vovas.engine.panel.assets:field-str opt "pathPrefix")) "_unpack")))
       (files '()))
  (vovas.engine.panel.export:finalize-zip-with-recon
   (lambda (path content) (push (cons path content) files))
   assets recon nil payloads opts)
  (setf files (nreverse files))
  (dolist (want (coerce (gethash "files" exp) 'list))
    (let* ((path (coerce (vovas.engine.panel.assets:field-str want "path") 'string))
           (got (cdr (assoc path files :test #'string=)))
           (wt (vovas.engine.panel.assets:field want "content")))
      (when (and wt got (stringp got))
        (let* ((w (coerce wt 'string))
               (wg (vovas.engine.gate::gate-strip-clock-text got))
               (ww (vovas.engine.gate::gate-strip-clock-text w)))
          (unless (string= wg ww)
            (format t "~%==== ~a  (got ~a / want ~a chars)~%" path (length got) (length w))
            (let ((d (vovas.engine.gate::gate-first-difference wg ww)))
              (format t "  ~a~%" d))
            (let ((i (or (search (subseq wg 0 (min 20 (length wg))) ww) 0)))
              (declare (ignore i)))))))))
