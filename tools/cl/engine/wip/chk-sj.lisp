(require :asdf)
(load "C:/Users/bigmo/quicklisp/setup.lisp")
(asdf:load-asd (truename "tools/cl/vovas-engine.asd"))
(asdf:load-system :vovas-engine)
(let* ((o (vovas.engine.gate::read-json-file
           "C:/Users/bigmo/Downloads/vovas-devtools-soruce-downloader/unpack-rs/tests/fixtures/stack-profile.json"))
       (e (gethash "empty" o)))
  (format t "~&entry type: ~a~%" (type-of e))
  (format t "entry keys: ~s~%" (loop for k being the hash-keys of e collect k))
  (let ((p (gethash "profile" e)))
    (format t "profile type: ~a~%" (type-of p))
    (format t "profile keys: ~s~%" (and (hash-table-p p)
                                        (loop for k being the hash-keys of p collect k)))
    (let ((pl (vovas.engine.gate::stack-json p)))
      (format t "stack-json len: ~a~%" (length pl))
      (format t "stack-json head: ~s~%" (subseq pl 0 (min 12 (length pl)))))))
(finish-output)
