(require :asdf)
(load "C:/Users/bigmo/quicklisp/setup.lisp")
(ql:quickload '("cl-ppcre" "com.inuoe.jzon" "ironclad" "babel" "chipz" "salza2" "cl-unicode") :silent t)
(dolist (f '("package" "util" "number" "transforms" "decoders" "scanner" "digest"
             "bundler" "text" "beautify" "detectors" "sourcemaps" "packers"
             "wasm" "jscbytecode" "v8codecache" "zip" "jsfuck" "pipeline" "assets"))
  (load (compile-file (format nil "tools/cl/engine/~a.lisp" f)
                      :output-file (format nil "C:/Users/bigmo/AppData/Local/Temp/gr-~a.fasl" f))))
(load (compile-file "tools/cl/engine/gate.lisp"
                    :output-file "C:/Users/bigmo/AppData/Local/Temp/gr-gate.fasl"))

(let* ((fx (vovas.engine.gate::read-json-file
            "C:/Users/bigmo/Downloads/vovas-devtools-soruce-downloader/unpack-rs/tests/fixtures/panel/assets-oracle-paired.json"))
       (secs (gethash "sections" fx))
       (ok 0) (bad 0))
  (flet ((cmp (label got want)
           (if (equal got want) (incf ok)
               (progn (incf bad)
                      (format t "~&  DIFF ~a~%    want ~s~%    got  ~s~%" label want got)))))
    (dolist (c (coerce (gethash "normalizeUrlKey" secs) 'list))
      (cmp "normalizeUrlKey" (vovas.engine.panel.assets:normalize-url-key (gethash "input" c))
           (gethash "expected" c)))
    (dolist (c (coerce (gethash "stripUrlVariant" secs) 'list))
      (cmp "stripUrlVariant" (vovas.engine.panel.assets:strip-url-variant (gethash "input" c))
           (gethash "expected" c)))
    (dolist (c (coerce (gethash "getBareFileName" secs) 'list))
      (cmp "getBareFileName" (vovas.engine.panel.assets:get-bare-file-name (gethash "input" c))
           (gethash "expected" c)))
    (dolist (c (coerce (gethash "cleanStackReference" secs) 'list))
      (cmp "cleanStackReference" (vovas.engine.panel.assets:clean-stack-reference (gethash "input" c))
           (gethash "expected" c)))
    (dolist (c (coerce (gethash "detectStartupSignals" secs) 'list))
      (cmp "detectStartupSignals"
           (coerce (vovas.engine.panel.assets:detect-startup-signals "https://x/app.js" (gethash "input" c)) 'list)
           (coerce (gethash "expected" c) 'list)))
    (dolist (c (coerce (gethash "extractRouteHintsFromUrl" secs) 'list))
      (cmp "extractRouteHintsFromUrl"
           (coerce (vovas.engine.panel.assets:extract-route-hints-from-url (gethash "input" c)) 'list)
           (coerce (gethash "expected" c) 'list)))
    (dolist (c (coerce (gethash "extractImportSpecifiers" secs) 'list))
      (cmp "extractImportSpecifiers"
           (coerce (vovas.engine.panel.assets:extract-import-specifiers (gethash "input" c)) 'list)
           (coerce (gethash "expected" c) 'list)))
    (dolist (c (coerce (gethash "detectBundlerName" secs) 'list))
      (let ((in (gethash "input" c)))
        (cmp "detectBundlerName"
             (vovas.engine.panel.assets:detect-bundler-name (aref in 0) (aref in 1))
             (gethash "expected" c)))))
  (format t "~&~%assets helper tier: ~a ok, ~a diff~%" ok bad))
(sb-ext:exit :code 0)
