;;;; gate-assets.lisp — the script-asset helper tier.
;;;;
;;;; Driven by `assets-oracle-paired.json`, which pairs each input with the value
;;;; the Rust oracle expects. That pairing is generated by
;;;; `scripts/assets-oracle-paired.mjs` from the Rust test block, and the generator
;;;; REFUSES to emit a fixture whose input count disagrees with its expected count -
;;;; so this gate cannot silently test fewer cases than it names.
;;;;
;;;; SCOPE: the helper tier only. `prepare-script-assets`, `build-chunk-summary`,
;;;; `strip-chunk-asset`, `build-runtime-origins`, `strip-runtime-entry` and the
;;;; scoring functions are NOT ported, and this gate does not assert them. A green
;;;; run here means the detection helpers match the engine; it says nothing about
;;;; the pipeline tier.

(in-package :vovas.engine.gate)

(defun assets-paired-section (sections name)
  "The case vector for NAME, or an empty vector.

An absent section is a FIXTURE problem, not a zero-case pass: the caller asserts
a non-zero count, so a renamed section fails loudly."
  (let ((v (gethash name sections)))
    (if (vectorp v) v #())))

(defun run-assets-gate (&key (verbose t))
  (let* ((fixture (read-json-file (fixture-path "panel/assets-oracle-paired.json")))
         (sections (gethash "sections" fixture))
         (result (make-gate-result))
         (count 0)
         (assets (find-package :vovas.engine.panel.assets)))

    (unless assets
      (error "the assets module is not loaded"))

    (flet ((each (section fn)
             (loop for case across (assets-paired-section sections section)
                   do (incf count)
                      (funcall fn (gethash "input" case) (gethash "expected" case)))))
      ;; single-string functions
      (each "normalizeUrlKey"
            (lambda (in want)
              (check result "normalizeUrlKey" (format nil "~s" in)
                     (vovas.engine.panel.assets:normalize-url-key in) want)))
      (each "stripUrlVariant"
            (lambda (in want)
              (check result "stripUrlVariant" (format nil "~s" in)
                     (vovas.engine.panel.assets:strip-url-variant in) want)))
      (each "getBareFileName"
            (lambda (in want)
              (check result "getBareFileName" (format nil "~s" in)
                     (vovas.engine.panel.assets:get-bare-file-name in) want)))
      (each "cleanStackReference"
            (lambda (in want)
              (check result "cleanStackReference" (format nil "~s" in)
                     (vovas.engine.panel.assets:clean-stack-reference in) want)))
      ;; list-returning functions
      (each "detectStartupSignals"
            (lambda (in want)
              (check result "detectStartupSignals" (subseq in 0 (min 28 (length in)))
                     (coerce (vovas.engine.panel.assets:detect-startup-signals
                              "https://x/app.js" in)
                             'list)
                     (coerce want 'list))))
      (each "extractRouteHintsFromUrl"
            (lambda (in want)
              (check result "extractRouteHintsFromUrl" in
                     (coerce (vovas.engine.panel.assets:extract-route-hints-from-url in)
                             'list)
                     (coerce want 'list))))
      (each "extractImportSpecifiers"
            (lambda (in want)
              (check result "extractImportSpecifiers" (subseq in 0 (min 28 (length in)))
                     (coerce (vovas.engine.panel.assets:extract-import-specifiers in) 'list)
                     (coerce want 'list))))
      ;; two-argument functions: the paired input is [url, content]
      (each "detectBundlerName"
            (lambda (in want)
              (check result "detectBundlerName"
                     (format nil "~a | ~a" (aref in 0) (aref in 1))
                     (vovas.engine.panel.assets:detect-bundler-name
                      (aref in 0) (aref in 1))
                     want)))
      (each "detectFrameworkHints"
            (lambda (in want)
              (check result "detectFrameworkHints"
                     (format nil "~a | ~a" (aref in 0) (aref in 1))
                     (coerce (vovas.engine.panel.assets:detect-framework-hints
                              (aref in 0) (aref in 1))
                             'list)
                     (coerce want 'list))))

    ;; the paired fixture must actually carry the sections asserted above
    (dolist (name '("normalizeUrlKey" "stripUrlVariant" "getBareFileName"
                    "cleanStackReference" "detectStartupSignals"
                    "extractRouteHintsFromUrl" "extractImportSpecifiers"
                    "detectBundlerName" "detectFrameworkHints"))
      (incf count)
      (check result "fixture/section-present" name
             (plusp (length (assets-paired-section sections name))) t))

    (when verbose
      (format t "~&assets gate: ~a/~a cases match (helper tier)~%"
              (gate-result-passed result) (gate-result-total result))
      (report-failures result))
    (and (= (gate-result-passed result) (gate-result-total result))
         (plusp count)))))
