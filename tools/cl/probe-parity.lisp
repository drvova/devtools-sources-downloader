(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (merge-pathnames "tools/cl/vovas-engine.asd" (uiop:getcwd)))
(asdf:load-system :vovas-engine :force :all)
(in-package :vovas.engine.gate)
(let* ((o (read-json-file (fixture-path "panel/finalize-oracle.json")))
       (inp (gethash "inputs" o))
       (opt (gethash "options" inp))
       (files '())
       (assets (coerce (gethash "jsAssets" inp) 'list))
       (recon (gethash "reconData" inp))
       (payloads (gethash "runtimePayloads" inp))
       (opts (vovas.engine.pipeline:make-unpack-options
              :path-prefix (or (and opt (vovas.engine.panel.assets:field-str opt "pathPrefix"))
                               "_unpack")))
       (merged (vovas.engine.panel.export:finalize-zip-with-recon
                (lambda (p c) (push (cons p c) files))
                assets recon nil payloads opts)))
  (setf files (nreverse files))
  (format t "~&PTOTAL ~a~%" (length files))
  (format t "~&PSUMMARY ~a~%" (vovas.engine.panel.export:export-summary merged))
  (dolist (f (subseq files 0 (min 6 (length files))))
    (format t "~&PPATH ~a~%" (car f))))
