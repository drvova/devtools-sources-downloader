{
    "name": "devtools-sources-downloader",
    "version": "0.1.0",
    "private": true,
    "description": "DevTools extension - download inspected page sources with debug mode",
    "scripts": {
        "build": "npm run build:engine && rs build",
        "dev": "npm run build:engine && set NODE_ENV=development&& rs build --source-map",
        "watch": "rs build --watch --source-map",
        "test": "rs test",
        "test:e2e": "node test/browser-e2e.mjs",
        "lint": "rs lint",
        "format": "rs fmt",
        "check": "rs check",
        "verify": "npm test && npm run build && npm run test:e2e && npm run test:e2e:ext",
        "dev:ext": "node scripts/dev-ext.mjs",
        "test:e2e:ext": "node test/browser-e2e-extension.mjs",
        "build:engine": "node scripts/build-engine.cjs"
    },
    "dependencies": {
        "file-saver": "^2.0.5",
        "jszip": "^3.10.1"
    },
    "devDependencies": {
        "@puppeteer/browsers": "^3.2.6",
        "js-beautify": "^2.0.3",
        "rstack": "^0.8.6"
    }
}