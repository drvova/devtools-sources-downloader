# dependencies
node_modules/

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.log

# dev-build source maps
*.js.map

# Chrome for Testing download + dev extension profile
.cache/
cdp-profile/

# SBCL toolchain artifacts: the saved image and release zips are build output.
# Compiled fasls are build output too, and an UNTRACKED one sitting beside the
# sources is actively dangerous: a stale fasl loads in preference to the source
# and produces "these symbols are not accessible" errors that look like source
# bugs. Ignoring them makes a stray one visible in `git status` behaviour rather
# than invisible.
tools/cl/vovas.exe
tools/cl/**/*.fasl
tools/cl/**/*.fas
unpack-rs/dist-*.zip

# scratch: per-module dev runners, probes and captured gate output.
# The runners in wip/ are how each slice was debugged; they are not part of the
# gate (run-engine.lisp is) and several are one-off probes tied to a single
# investigation. out/ holds captured stdout used to diff runs.
tools/cl/engine/wip/out/
tools/cl/engine/wip/*.txt
