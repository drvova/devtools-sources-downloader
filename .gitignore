# dependencies
node_modules/

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.log

# dev-build source maps
*.js.map

# Chrome for Testing download + dev extension profile
.cache/
cdp-profile/

# SBCL toolchain artifacts: the saved image and release zips are build output.
# Compiled fasls are build output too, and an UNTRACKED one sitting beside the
# sources is actively dangerous: a stale fasl loads in preference to the source
# and produces "these symbols are not accessible" errors that look like source
# bugs. Ignoring them makes a stray one visible in `git status` behaviour rather
# than invisible.
tools/cl/vovas.exe
tools/cl/**/*.fasl
tools/cl/**/*.fas

# scratch: one-off probes and captured gate output. Nothing in wip/ is part of
# the gate (run-engine.lisp is), so nothing in it is tracked.
tools/cl/engine/wip/
